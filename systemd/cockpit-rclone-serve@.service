[Unit]
Description=Serveur rclone serve cockpit-rclone (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/cockpit-rclone/rclone-job-runner.py serve %i
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=15s
# Durcissement (vérification Claude 2026-11-24, R1/R3). Le lanceur garde juste ce qu'il faut
# pour copier rclone.conf et perdre les droits root ; rclone serve tourne sous run_as.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN
ProtectSystem=full
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
