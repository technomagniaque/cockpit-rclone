[Unit]
Description=Montage FUSE cockpit-rclone (%i)
After=network-online.target
Wants=network-online.target

[Service]
# Durcissement sans espace de noms de montage (vérification Claude 2026-11-24, R3) :
# les snapshots ZFS (.zfs/snapshot) et les montages FUSE doivent rester visibles de l'hôte.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
Type=simple
ExecStartPre=/usr/bin/python3 /usr/lib/cockpit-rclone/rclone-job-runner.py mount-prep %i
ExecStart=/usr/bin/python3 /usr/lib/cockpit-rclone/rclone-job-runner.py mount %i
ExecStop=/usr/bin/python3 /usr/lib/cockpit-rclone/rclone-job-runner.py mount-stop %i
Restart=on-failure
RestartSec=10s
KillMode=mixed
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
